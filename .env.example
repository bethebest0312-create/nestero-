# Copy to .env and fill values
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=changeme
OPENAI_API_KEY=sk-REPLACE_ME
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
# Example Stripe price ID for subscription
STRIPE_PRICE_ID=price_XXXXXXXXXXXX
# Free API defaults
FREE_API_DEFAULT_QUOTA=1000

# SMTP for email advertisements (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="Nestero <no-reply@example.com>"

# Vercel deploy (for GitHub Actions) — set in repo secrets for real deploys
VERCEL_TOKEN=xxx
VERCEL_ORG_ID=xxx
VERCEL_PROJECT_ID=xxx

# Optional
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SendGrid (preferred) or SMTP will be used by mail helper
SENDGRID_API_KEY=

# Admin token for simple admin endpoints (keep secret)
ADMIN_TOKEN=changeme

# Redis (optional) for rate limiting and caching
REDIS_URL=redis://localhost:6379

# Seed admin user email for prisma/seed.js
ADMIN_SEED_EMAIL=admin@example.com
